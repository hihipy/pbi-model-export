# >>> managed gitignore: begin (sync-gitignores.zsh) >>>
# Edits inside this block are overwritten. Put repo-specific rules outside it.

# --- macOS -------------------------------------------------------------------
.DS_Store
._*
.AppleDouble
.AppleDB
.AppleDesktop
.LSOverride
# The macOS custom-icon file is named "Icon" plus a carriage return. Git strips
# one trailing CR from a pattern line, so the pattern needs two. A wildcard
# form such as "Icon?" also matches any directory named "icons" wherever
# core.ignorecase is on, which is the default on macOS.
Icon
.Spotlight-V100
.DocumentRevisions-V100
.TemporaryItems
.Trashes
.fseventsd
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.apdisk
Network Trash Folder
Temporary Items

