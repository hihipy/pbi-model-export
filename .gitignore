# --- agent and assistant local state -----------------------------------------
.claude/settings.local.json
# --- secrets and credentials -------------------------------------------------
# Deliberately broad. A leaked key costs more than a hidden fixture. Where a
# repo needs a fixture certificate, add a scoped negation below the block, for
# example !tests/fixtures/*.pem, which works because tests/fixtures/ is not
# itself ignored.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk
# "*.key" is deliberately absent: Keynote decks are directories named *.key.
secrets.json
credentials.json
service-account*.json
.secrets/
# --- local databases and dumps -----------------------------------------------
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
*.dump
# --- build noise and scratch -------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.pid
.tmp/
.scratch/
