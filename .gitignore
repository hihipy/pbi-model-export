# --- editors and IDEs --------------------------------------------------------
# .vscode/* rather than .vscode/, so the negations below stay reachable. A
# negation cannot re-include a file whose parent directory is excluded.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace
.idea/
