# The next line is "Icon" followed by two carriage returns. Git strips one, and
# the macOS custom-icon file carries the other. A plain "Icon" line would hide
# every path with that name. Verify with: grep -c $'Icon\r\r' .gitignore
Icon
.Spotlight-V100
.DocumentRevisions-V100
.TemporaryItems
.Trashes
.fseventsd
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.apdisk
